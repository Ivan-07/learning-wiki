{
  "$id": "https://learning-wiki.local/schemas/source-version-record.schema.json",
  "additionalProperties": true,
  "description": "manifest.yaml 中 versions[] 的一项。",
  "properties": {
    "content_hash": {
      "title": "Content Hash",
      "type": "string"
    },
    "content_path": {
      "default": "",
      "title": "Content Path",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "evidence_path": {
      "default": "",
      "title": "Evidence Path",
      "type": "string"
    },
    "extraction_method": {
      "title": "Extraction Method",
      "type": "string"
    },
    "extraction_quality": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extraction Quality"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "original_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Original Hash"
    },
    "original_paths": {
      "items": {
        "type": "string"
      },
      "title": "Original Paths",
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "version_id": {
      "title": "Version Id",
      "type": "string"
    }
  },
  "required": [
    "version_id",
    "created_at",
    "extraction_method",
    "content_hash"
  ],
  "title": "SourceVersionRecord",
  "type": "object"
}
