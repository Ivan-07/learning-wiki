{
  "$id": "https://learning-wiki.local/schemas/note-frontmatter.schema.json",
  "additionalProperties": true,
  "description": "Wiki 页面 YAML frontmatter。",
  "properties": {
    "aliases": {
      "items": {
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "last_verified_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Verified At"
    },
    "note_id": {
      "title": "Note Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "reviewed",
        "disputed",
        "deprecated"
      ],
      "title": "Status",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "type": {
      "default": "concept",
      "enum": [
        "concept",
        "comparison",
        "synthesis",
        "open_question"
      ],
      "title": "Type",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "note_id",
    "title",
    "created_at",
    "updated_at"
  ],
  "title": "NoteFrontmatter",
  "type": "object"
}
