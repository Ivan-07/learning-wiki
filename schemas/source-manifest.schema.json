{
  "$defs": {
    "SourceVersionRecord": {
      "additionalProperties": true,
      "description": "manifest.yaml 中 versions[] 的一项。",
      "properties": {
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "content_path": {
          "default": "",
          "title": "Content Path",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "evidence_path": {
          "default": "",
          "title": "Evidence Path",
          "type": "string"
        },
        "extraction_method": {
          "title": "Extraction Method",
          "type": "string"
        },
        "extraction_quality": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extraction Quality"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "original_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Hash"
        },
        "original_paths": {
          "items": {
            "type": "string"
          },
          "title": "Original Paths",
          "type": "array"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "version_id": {
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "created_at",
        "extraction_method",
        "content_hash"
      ],
      "title": "SourceVersionRecord",
      "type": "object"
    }
  },
  "$id": "https://learning-wiki.local/schemas/source-manifest.schema.json",
  "additionalProperties": true,
  "description": "10 Sources/{source_id}/manifest.yaml 的模型。",
  "properties": {
    "active_version": {
      "title": "Active Version",
      "type": "string"
    },
    "author": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author"
    },
    "canonical_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canonical Url"
    },
    "captured_at": {
      "title": "Captured At",
      "type": "string"
    },
    "published_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "rights_status": {
      "default": "user_accessible",
      "title": "Rights Status",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_type": {
      "enum": [
        "text",
        "file",
        "web"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "value_state": {
      "default": "reference",
      "enum": [
        "reference",
        "learn",
        "apply",
        "archived"
      ],
      "title": "Value State",
      "type": "string"
    },
    "versions": {
      "items": {
        "$ref": "#/$defs/SourceVersionRecord"
      },
      "title": "Versions",
      "type": "array"
    }
  },
  "required": [
    "source_id",
    "source_type",
    "title",
    "captured_at",
    "active_version",
    "versions"
  ],
  "title": "SourceManifest",
  "type": "object"
}
